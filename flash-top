#!/usr/bin/env python3
"""flash-top — a live system dashboard for the terminal.

Reads what the Flash Stats widget reads, from the same places. The Mach host
statistics the widget calls from Rust are reachable through ctypes, so CPU and
memory come straight from the kernel with no subprocess in the render path.
Everything that needs a command (ioreg, netstat, ps, nettop) runs on a
background thread at its own interval, so a frame never waits for one.

Standard library only.
"""

from __future__ import annotations

