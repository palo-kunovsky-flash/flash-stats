def help_screen(cols):
    W = max(40, cols - 1)
    w = W - 1
    out = [f"{BOLD}{C_WHITE}flash-top{RST}  {C_GREY}help — what every number means{RST}", ""]
    for title, meta, items in HELP:
        out += section(title, meta, w)
        for term, text in items:
            wrapped = textwrap.wrap(text, max(20, w - LABEL_W - 1)) or [""]
            for j, chunk in enumerate(wrapped):
                out.append(line(term if j == 0 else "", C_GREY + chunk + RST, w, WHITE))
        out.append("")
    out = [" " + l for l in out]
    out.append(" " + fit(f"{C_GREY}h{RST} {C_FAINT}or{RST} {C_GREY}Esc{RST} "
                         f"{C_FAINT}back to the dashboard{RST}", w))
    return [fit(l, W) for l in out]


# ── frame ─────────────────────────────────────────────────────────────────────
def body_at(s, now, w, lay):
    """Every panel rendered at one candidate's column width, packed."""
    global LABEL_W
    LABEL_W = lay.label_w
    cw = lay.colw
    parts = [
        cpu_section(s, cw, lay),
        memory_section(s, cw, lay),
        gpu_section(s, cw, lay),
        disk_section(s, cw, now, lay),
    ]
    if lay.split_net:
        parts += [network_section(s, cw, lay, tables=False),
                  interfaces_section(s, cw, lay),
                  talkers_section(s, cw, lay)]
    else:
        parts.append(network_section(s, cw, lay))
    parts += [
        temps_section(s, cw, lay),
        processes_section(s, cw, lay),
    ]
    return lay.pack(parts)


def choose_body(s, now, w, lines, want=0):
    """Build the frame in every column count that fits and keep the shortest.

    A fixed minimum column width was only ever a guess at where another column
    stops paying for itself. Measuring is cheap — the panels are strings — and
    it answers the real question: which arrangement shows the whole machine in
    the fewest lines. Ties go to fewer, wider columns.

    The previous choice has to be beaten by a clear margin, or a list that
    gains a row would flip the whole layout from one frame to the next.
    """
    if want:
        # Asked for explicitly: give them that many, or as many as still leave
        # a panel worth the name.
        for cols in range(min(want, Layout.MAX_COLS), 0, -1):
            lay = viable(w, lines, cols, Layout.HARD_MIN)
            if lay is not None:
                s.last_cols = lay.cols
                return lay, body_at(s, now, w, lay)
    best = None
    for cols in range(1, Layout.MAX_COLS + 1):
        lay = viable(w, lines, cols)
        if lay is None:
            continue
        body = body_at(s, now, w, lay)
        key = (len(body), cols)
        if best is None or key < best[0]:
            best = (key, lay, body)
    if best is None:  # cannot happen: one column always fits
        lay = Layout(w, lines, 1)
        return lay, body_at(s, now, w, lay)
    if s.last_cols and s.last_cols != best[1].cols:
        keep = viable(w, lines, s.last_cols)
        if keep is not None:
            held = body_at(s, now, w, keep)
            if len(held) <= len(best[2]) + 2:
                best = ((len(held), keep.cols), keep, held)
    s.last_cols = best[1].cols
    return best[1], best[2]


def render(s, now, cols, lines=50, want_cols=0):
    # One column short of the edge: a glyph in the last column leaves some
    # terminals in a pending-wrap state that eats the next line.
    global LABEL_W
    W = max(40, cols - 1)
    pad_l = 1
    w = W - pad_l
    lay, body = choose_body(s, now, w, lines, want_cols)
    LABEL_W = lay.label_w
    out = []

    left = f"{BOLD}{C_WHITE}flash-top{RST}  {C_GREY}{s.meta['chip']}{RST}"
    host = s.meta["host"]
    up = fmt_dur(now - s.meta["boot"]) if s.meta["boot"] else ""
    right = f"{C_GREY}{host}{RST}  {C_FAINT}up {up}{RST}  " \
            f"{C_FAINT}{dt.datetime.fromtimestamp(now):%H:%M:%S}{RST}"
    gap = w - vis_len(left) - vis_len(right)
    out.append(left + " " * gap + right if gap >= 2 else fit(left, w))
    out.append("")

    out += system_section(s, w, now, lay)
    out.append("")
    out += body

    out = [" " * pad_l + l for l in out]
    keys = (f"{C_GREY}q{RST} {C_FAINT}quit{RST}  {C_GREY}↑↓{RST} {C_FAINT}scroll{RST}  "
            f"{C_GREY}r{RST} {C_FAINT}refresh{RST}  {C_GREY}h{RST} {C_FAINT}help{RST}")
    out.append(" " + fit(keys, w))
    return [fit(l, W) for l in out]


def term_size(live):
    """The live tty size when interactive; shutil (which honours $COLUMNS)
    for a one-shot frame, so a width can be forced for a test.

    A pty opened without a window size reports zeroes, and a frame drawn into
    a 0x0 terminal is one line tall; fall back when the answer is not usable.
    """
    if live:
        try:
            size = os.get_terminal_size(sys.stdout.fileno())
            if size.columns >= 20 and size.lines >= 5:
                return size
        except OSError:
            pass
    return shutil.get_terminal_size((160, 50))


def prime(s, interval, budget):
    """Two samples make a rate, so a first frame needs more than one of each.

    The workers get a head start, then a second round is forced far enough
    after the first that the differences mean something; the budget caps the
    whole thing so `--once` stays quick.
    """
    s.tick()
    s.start()
    deadline = time.time() + budget
    needed = ("net", "gpu", "procs", "space", "power", "links")
    while time.time() < deadline and not all(s.age(k) is not None for k in needed):
        time.sleep(0.1)
    time.sleep(min(max(0.2, deadline - time.time()), max(interval, s.MIN_PROC_DT + 0.1)))
    first = {k: s.stamp.get(k) for k in ("net", "procs", "diskio")}
    s.refresh_now()
    while time.time() < deadline + 2 and \
            any(s.stamp.get(k) == v for k, v in first.items()):
        time.sleep(0.05)
    s.tick()


# ── main loop ─────────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser(description="Live system dashboard for the terminal.")
    ap.add_argument("-i", "--interval", type=float, default=2.0,
                    help="refresh, seconds (default 2)")
    ap.add_argument("--once", action="store_true", help="print one frame and exit")
    ap.add_argument("--no-net", action="store_true",
                    help="never ask the internet for the public address")
    ap.add_argument("-c", "--cols", type=int, default=0, metavar="N",
                    help="force N columns of panels (default: whichever shows "
                         "the whole machine in the fewest lines)")
    ap.add_argument("--wait", type=float, default=6.0,
                    help="how long --once may wait for the slow sources (default 6)")
    args = ap.parse_args()
    interval = max(0.25, args.interval)

    if not DARWIN:
        print("flash-top reads macOS interfaces; most metrics will read n/a here.",
              file=sys.stderr)

    s = Sampler(interval, no_net_calls=args.no_net)
    one_shot = args.once or not sys.stdout.isatty()
    prime(s, interval, args.wait if one_shot else 1.0)

    if one_shot:
        size = term_size(live=False)
        print("\n".join(render(s, time.time(), size.columns, size.lines, args.cols)))
        s.shutdown()
        return

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    signal.signal(signal.SIGWINCH, lambda *_: None)  # wakes select() to redraw
    # Alt screen, hidden cursor, wheel reporting (hold Option/Shift to select text).
    sys.stdout.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")
    try:
        tty.setcbreak(fd)
        # priming already took a sample; ticking again straight away would
        # measure a millisecond of CPU time and report nonsense for it.
        next_tick, scroll, show_help = time.time() + interval, 0, False
        while True:
            now = time.time()
            if now >= next_tick:
                s.tick()
                next_tick = now + interval
            size = term_size(live=True)
            frame = help_screen(size.columns) if show_help \
                else render(s, now, size.columns, size.lines, args.cols)
            # Header and footer stay put; the panels between them scroll.
            body, view_h = frame[1:-1], max(1, size.lines - 2)
            scroll = max(0, min(scroll, len(body) - view_h))
            footer = frame[-1]
            if len(body) > view_h:  # position first, so a narrow window still shows it
                footer = (C_GREY + f" {scroll + 1}-{scroll + view_h} of {len(body)} "
                          + RST + footer)
            if vis_len(footer) > size.columns - 1:
                footer = trunc(footer, size.columns - 1)
            frame = [frame[0]] + body[scroll:scroll + view_h] + [footer]
            sys.stdout.write("\033[H" + "\n".join(l + "\033[K" for l in frame) + "\033[J")
            sys.stdout.flush()
            # Wake at least each second so the clock stays live.
            wait = max(0.1, min(1.0, next_tick - time.time()))
            try:
                ready, _, _ = select.select([sys.stdin], [], [], wait)
            except InterruptedError:
                continue
            if not ready:
                continue
            key = os.read(fd, 256).decode(errors="ignore")
            page = max(1, size.lines - 4)
            # Mouse wheel (SGR 1006): button 64 up, 65 down; may batch.
            scroll -= 3 * len(re.findall(r"\033\[<64;", key))
            scroll += 3 * len(re.findall(r"\033\[<65;", key))
            for seq, delta in (("\033[A", -1), ("\033[B", 1),
                               ("\033[5~", -page), ("\033[6~", page)):
                scroll += delta * key.count(seq)
            key = re.sub(r"\033\[[0-9;<]*[A-Za-z~]", "", key)  # plain keys only from here
            if "h" in key or "?" in key or (show_help and "\033" in key):
                show_help, scroll = not show_help, 0
                continue
            scroll += key.count("j") - key.count("k") + page * (key.count(" ") - key.count("b"))
            if "g" in key:
                scroll = 0
            if "G" in key:
                scroll = 10 ** 6
            if "r" in key:
                s.refresh_now()
                next_tick = 0
            if "q" in key or "\x03" in key:
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")
        sys.stdout.flush()
        s.shutdown()


if __name__ == "__main__":
    main()
