{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flash Stats",
  "version": "0.1.0",
  "identifier": "com.kunovsky.flashstats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flash Stats",
        "width": 320,
        "height": 460,
        "minWidth": 220,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
