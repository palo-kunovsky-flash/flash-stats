{
  "name": "flash-stats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "macOS system monitor widgets (CPU / GPU / RAM / Battery / Network) with a menu-bar net meter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "probe": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example probe",
    "typecheck": "tsc --noEmit",
    "release": "APPLE_SIGNING_IDENTITY=- npm run tauri:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
